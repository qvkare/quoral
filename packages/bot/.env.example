# --- chain ---
CHAIN_ID=31337                  # 143 mainnet, 10143 testnet, 31337 anvil
RPC_URL=http://127.0.0.1:8545
AGREEMENT=                      # InventoryVault address (defaults to local deployment's demo agreement)

# --- operator signer: "local" (OPERATOR_KEY) or "privy" (policy-locked server wallet) ---
SIGNER=local
OPERATOR_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a   # anvil #4, demo only
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# --- reference price: sim | book | static:<px> | http:<url>#<json.path> ---
REF_PRICE=sim
SIM_START_PRICE=3900

# --- Avellaneda–Stoikov ---
AS_GAMMA=0.1
AS_K=1.5
AS_HORIZON_S=60
LEVELS=3
DEPTH_BUFFER=1.25               # quote 25% above minDepthQuote per side
SPREAD_SAFETY=0.85              # never quote wider than 85% of maxSpreadBps
MIN_SPREAD_BPS=8

# --- keeper ---
KEEPER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80   # anvil #0, demo only
KEEPER_INTERVAL_S=10
