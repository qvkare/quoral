# Monad mainnet (143) / testnet (10143) deploy: `forge script script/Deploy.s.sol --rpc-url monad --broadcast`
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=
KURU_MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5   # mainnet; testnet: see docs.kuru.io
BOND_TOKEN=                      # USDC on the target chain
TREASURY=
FEE_BPS=1000                     # 10% of the retainer stream
MARKETS=                         # comma-separated Kuru OrderBooks (XAUt0-USDC, WETH-USDC, …) from api.kuru.io/api/v1/markets
CRE_FORWARDER=                   # Chainlink Keystone forwarder on Monad
